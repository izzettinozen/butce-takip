# Supabase bağlantı bilgileri
# Supabase Dashboard > Project Settings > API Keys bölümünden alın.

# Proje URL'i
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Publishable (anon) anahtar — yeni API anahtar sistemi
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Secret (service role) anahtar — yalnızca sunucu tarafında kullanılır, ASLA paylaşmayın
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
